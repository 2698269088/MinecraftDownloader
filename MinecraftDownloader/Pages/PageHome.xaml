<UserControl x:Class="MinecraftDownloader.Pages.PageHome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource LaunchFontFamily}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource ColorBrushCard}"
                BorderBrush="{DynamicResource ColorBrushGray6}" BorderThickness="0,0,1,0">
            <Grid Margin="10,14,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="6,0,4,10">
                    <TextBlock Text="已安装版本" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="LabCount" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" />
                </Grid>
                <ListBox x:Name="ListInstances" Grid.Row="1" SelectionChanged="ListInstances_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,7">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SubTitle}" Style="{StaticResource SecondaryText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button Content="下载新版本" Style="{DynamicResource PrimaryButton}" Height="34"
                            Click="BtnDownload_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,18,20,24">
                <Border Style="{StaticResource MyCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="LabInstanceTitle" Text="还没有安装任何版本" FontSize="21"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="LabInstanceSub" Text="点击左侧「下载新版本」开始安装"
                                           Style="{StaticResource SecondaryText}" Margin="0,6,0,0" FontSize="12.5" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource ColorBrush8}" CornerRadius="4" Padding="8,3">
                                <TextBlock x:Name="LabLoader" Text="未选择" FontSize="11"
                                           Foreground="{DynamicResource ColorBrush2}" />
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="BtnOpenFolder" Content="打开版本文件夹"
                                    Style="{DynamicResource PrimaryButton}" Height="38" Click="BtnOpenFolder_Click" />
                            <Button x:Name="BtnMods" Content="mods 文件夹" Style="{DynamicResource SecondaryButton}"
                                    Height="38" Margin="10,0,0,0" Click="BtnMods_Click" />
                            <Button x:Name="BtnExportPack" Content="导出整合包" Style="{DynamicResource SecondaryButton}"
                                    Height="38" Margin="10,0,0,0" Click="BtnExportPack_Click" />
                            <Button x:Name="BtnDelete" Content="删除版本" Style="{DynamicResource SecondaryButton}"
                                    Height="38" Margin="10,0,0,0" Click="BtnDelete_Click" />
                        </StackPanel>
                        <TextBlock Text="版本以标准 .minecraft 结构安装，启动游戏请使用 PCL、HMCL 等启动器选择该版本。"
                                   Style="{StaticResource SecondaryText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MyCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="快速下载" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="4">
                            <Button Content="原版游戏" Style="{DynamicResource SecondaryButton}" Height="38"
                                    Margin="0,0,8,0" Click="BtnQuickVanilla_Click" />
                            <Button Content="模组加载器" Style="{DynamicResource SecondaryButton}" Height="38"
                                    Margin="0,0,8,0" Click="BtnQuickLoader_Click" />
                            <Button Content="模组" Style="{DynamicResource SecondaryButton}" Height="38"
                                    Margin="0,0,8,0" Click="BtnQuickMod_Click" />
                            <Button Content="整合包" Style="{DynamicResource SecondaryButton}" Height="38"
                                    Click="BtnQuickPack_Click" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MyCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="版本信息" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="版本 ID：" />
                            <TextBlock x:Name="LabId" Grid.Column="1" Text="-" />
                            <TextBlock Grid.Row="1" Text="游戏版本：" Margin="0,8,0,0" />
                            <TextBlock x:Name="LabMc" Grid.Row="1" Grid.Column="1" Text="-" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Text="模组数量：" Margin="0,8,0,0" />
                            <TextBlock x:Name="LabMods" Grid.Row="2" Grid.Column="1" Text="-" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="3" Text="所在目录：" Margin="0,8,0,0" />
                            <TextBlock x:Name="LabPath" Grid.Row="3" Grid.Column="1" Text="-" Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MyCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="日志" Style="{StaticResource SectionTitle}" />
                            <Button Content="清空" HorizontalAlignment="Right" Style="{DynamicResource LinkButton}"
                                    Margin="0,-6,0,0" Click="BtnClearLog_Click" />
                        </Grid>
                        <TextBox x:Name="TxtLog" Height="130" IsReadOnly="True" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                                 Background="{DynamicResource ColorBrushGray8}" BorderThickness="0" Padding="8,6" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
