<UserControl x:Class="MinecraftDownloader.Pages.PageInstance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource LaunchFontFamily}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource ColorBrushCard}" BorderBrush="{DynamicResource ColorBrushGray6}"
                BorderThickness="0,0,1,0">
            <Grid Margin="10,14,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="6,0,4,10">
                    <TextBlock Text="版本管理" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="LabCount" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" />
                </Grid>
                <ListBox x:Name="ListInstances" Grid.Row="1" SelectionChanged="ListInstances_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,7">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SubTitle}" Style="{StaticResource SecondaryText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,18,20,24">
                <Border Style="{StaticResource MyCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="LabTitle" Text="请选择一个版本" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock x:Name="LabSub" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="版本 ID：" />
                            <TextBlock x:Name="LabId" Grid.Column="1" Text="-" />
                            <TextBlock Grid.Row="1" Text="加载器：" Margin="0,8,0,0" />
                            <TextBlock x:Name="LabLoader" Grid.Row="1" Grid.Column="1" Text="-" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Text="游戏版本：" Margin="0,8,0,0" />
                            <TextBlock x:Name="LabMc" Grid.Row="2" Grid.Column="1" Text="-" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="3" Text="所在目录：" Margin="0,8,0,0" />
                            <TextBlock x:Name="LabPath" Grid.Row="3" Grid.Column="1" Text="-" Margin="0,8,0,0" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button x:Name="BtnFolder" Content="打开文件夹" Style="{DynamicResource PrimaryButton}"
                                    Width="120" Height="36" Click="BtnFolder_Click" />
                            <Button x:Name="BtnMods" Content="mods 文件夹" Style="{DynamicResource SecondaryButton}"
                                    Height="36" Margin="10,0,0,0" Click="BtnMods_Click" />
                            <Button x:Name="BtnExport" Content="导出整合包" Style="{DynamicResource SecondaryButton}"
                                    Height="36" Margin="10,0,0,0" Click="BtnExport_Click" />
                            <Button x:Name="BtnDelete" Content="删除" Style="{DynamicResource DangerButton}"
                                    Height="36" Margin="10,0,0,0" Click="BtnDelete_Click" />
                        </StackPanel>
                        <TextBlock x:Name="LabStatus" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MyCard}">
                    <StackPanel>
                        <TextBlock Text="模组列表" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="LabModsEmpty" Text="mods 文件夹为空" Style="{StaticResource SecondaryText}" />
                        <ListBox x:Name="ListMods" MaxHeight="260">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="10,5" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
