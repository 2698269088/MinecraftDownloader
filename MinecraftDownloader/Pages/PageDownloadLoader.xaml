<UserControl x:Class="MinecraftDownloader.Pages.PageDownloadLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource LaunchFontFamily}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,24">
            <Border Style="{StaticResource MyCard}" Padding="18">
                <StackPanel>
                    <TextBlock Text="安装模组加载器" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Fabric / Quilt 直接写入版本 JSON；Forge / NeoForge 会调用官方安装器（需要 Java）"
                               Style="{StaticResource SecondaryText}" Margin="0,5,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="游戏版本" />
                        <ComboBox x:Name="ComboMcVersion" Grid.Column="1" Width="260" HorizontalAlignment="Left"
                                  DisplayMemberPath="Id" SelectionChanged="ComboMcVersion_SelectionChanged" />

                        <TextBlock Grid.Row="1" Text="加载器" Margin="0,12,0,0" />
                        <ComboBox x:Name="ComboLoader" Grid.Row="1" Grid.Column="1" Width="260"
                                  HorizontalAlignment="Left" Margin="0,12,0,0" SelectionChanged="ComboLoader_SelectionChanged">
                            <ComboBoxItem Content="Fabric" IsSelected="True" />
                            <ComboBoxItem Content="Quilt" />
                            <ComboBoxItem Content="Forge" />
                            <ComboBoxItem Content="NeoForge" />
                        </ComboBox>

                        <TextBlock Grid.Row="2" Text="加载器版本" Margin="0,12,0,0" />
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" HorizontalAlignment="Left">
                            <ComboBox x:Name="ComboLoaderVersion" Width="260" />
                            <ProgressBar x:Name="BarLoader" Width="60" HorizontalAlignment="Right"
                                         Margin="0,0,-72,0" IsIndeterminate="True" Visibility="Collapsed" />
                        </Grid>

                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="BtnInstall" Content="开始安装" Style="{DynamicResource PrimaryButton}"
                                    Width="120" Height="34" Click="BtnInstall_Click" />
                            <TextBlock x:Name="LabHint" Style="{StaticResource SecondaryText}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MyCard}" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="说明" Style="{StaticResource SectionTitle}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryText}" LineHeight="21">
                        <Run Text="• 安装加载器前无需手动安装原版，程序会自动下载对应原版依赖。" />
                        <LineBreak />
                        <Run Text="• Forge / NeoForge 的官方安装器需要可用的 Java，且会在游戏目录生成启动配置。" />
                        <LineBreak />
                        <Run Text="• 安装完成后可在「版本管理」页看到新的版本实例。" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
