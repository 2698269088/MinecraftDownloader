<UserControl x:Class="MinecraftDownloader.Pages.PageDownloadModpack"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource LaunchFontFamily}">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource MyCard}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="整合包" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="从 Modrinth 安装整合包，或导入本地 .mrpack 文件" Style="{StaticResource SecondaryText}"
                               Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid>
                        <TextBox x:Name="TextSearch" Width="230" Padding="9,0,34,0" KeyDown="TextSearch_KeyDown"
                                 ToolTip="搜索整合包（回车）" />
                        <Button Style="{DynamicResource TitleButton}" Width="28" Height="28" HorizontalAlignment="Right"
                                Margin="0,0,1,0" Click="BtnSearch_Click" ToolTip="搜索">
                            <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource ColorBrushGray2}"
                                  StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <Button Content="导入本地整合包" Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0"
                            Height="30" Click="BtnImport_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource MyCardTight}">
            <Grid>
                <ListBox x:Name="ListPacks" Margin="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="6" Background="{DynamicResource ColorBrushGray8}"
                                        VerticalAlignment="Top">
                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="34" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0">
                                        <Run Text="{Binding Author}" />
                                        <Run Text="  ·  下载 " />
                                        <Run Text="{Binding Downloads, StringFormat=N0}" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" Content="安装" Height="28" Width="64"
                                        VerticalAlignment="Center" Style="{DynamicResource SecondaryButton}"
                                        Click="BtnInstallPack_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="LabEmpty" Text="输入关键词搜索整合包" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="LabStatus" Text="" Style="{StaticResource SecondaryText}" />
            <ProgressBar x:Name="BarBusy" Width="120" HorizontalAlignment="Right" IsIndeterminate="True"
                         Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
