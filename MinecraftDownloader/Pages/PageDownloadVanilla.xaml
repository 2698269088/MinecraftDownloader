<UserControl x:Class="MinecraftDownloader.Pages.PageDownloadVanilla"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource LaunchFontFamily}">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource MyCard}" Margin="0,0,0,12" Padding="16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="安装原版游戏" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="选择任意正式版或快照，自动补全依赖库与资源文件" Style="{StaticResource SecondaryText}"
                               Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox x:Name="ComboFilter" Width="110" SelectionChanged="ComboFilter_SelectionChanged">
                        <ComboBoxItem Content="正式版" IsSelected="True" />
                        <ComboBoxItem Content="快照" />
                        <ComboBoxItem Content="全部" />
                    </ComboBox>
                    <TextBox x:Name="TextSearch" Width="170" Margin="8,0,0,0" TextChanged="TextSearch_TextChanged"
                             ToolTip="搜索版本号" />
                    <Button Content="刷新列表" Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0"
                            Height="30" Click="BtnRefresh_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource MyCardTight}">
            <Grid>
                <ListBox x:Name="ListVersions" Margin="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Id}" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource SecondaryText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Center" Margin="10,0,14,0"
                                        Background="{Binding BadgeBackground}" CornerRadius="3" Padding="7,2">
                                    <TextBlock Text="{Binding TypeText}" FontSize="11"
                                               Foreground="{Binding BadgeBrush}" />
                                </Border>
                                <Button Grid.Column="2" Content="安装" Height="27" VerticalAlignment="Center"
                                        Style="{DynamicResource SecondaryButton}" Click="InstallButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="LabEmpty" Text="正在获取版本列表…" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="LabStatus" Text="" Style="{StaticResource SecondaryText}" />
            <ProgressBar x:Name="BarBusy" Width="140" HorizontalAlignment="Right" IsIndeterminate="True"
                         Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
