<UserControl x:Class="MinecraftDownloader.Pages.PageDownload"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource LaunchFontFamily}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="205" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource ColorBrushCard}" BorderBrush="{DynamicResource ColorBrushGray6}"
                BorderThickness="0,0,1,0">
            <Grid Margin="10,14,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="下载" FontSize="14" FontWeight="SemiBold" Margin="6,0,0,10" />
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavVanilla" Style="{StaticResource NavItem}" GroupName="DownloadNav"
                                 AutomationProperties.AutomationId="nav-vanilla"
                                 Tag="{StaticResource IconDownload}" Content="原版游戏" IsChecked="True"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavLoader" Style="{StaticResource NavItem}" GroupName="DownloadNav"
                                 AutomationProperties.AutomationId="nav-loader"
                                 Tag="{StaticResource IconGrid}" Content="模组加载器" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavMod" Style="{StaticResource NavItem}" GroupName="DownloadNav"
                                 AutomationProperties.AutomationId="nav-mod"
                                 Tag="{StaticResource IconPuzzle}" Content="模组" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavPack" Style="{StaticResource NavItem}" GroupName="DownloadNav"
                                 AutomationProperties.AutomationId="nav-modpack"
                                 Tag="{StaticResource IconPackage}" Content="整合包" Checked="Nav_Checked" />
                </StackPanel>
                <Border Grid.Row="2" Background="{DynamicResource ColorBrush8}" CornerRadius="4" Padding="9">
                    <StackPanel>
                        <TextBlock Text="下载源" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush2}" />
                        <TextBlock x:Name="LabSource" Text="BMCLAPI 镜像" FontSize="11"
                                   Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="PanContent" Grid.Column="1" />
    </Grid>
</UserControl>
