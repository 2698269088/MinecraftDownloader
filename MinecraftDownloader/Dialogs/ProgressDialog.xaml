<Window x:Class="MinecraftDownloader.Dialogs.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在进行" Width="520" Height="330" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" Background="{DynamicResource ColorBrushBackground}"
        ShowInTaskbar="False" FontFamily="{DynamicResource LaunchFontFamily}">
    <Border BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1" Background="White" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource ColorBrush3}" CornerRadius="5,5,0,0" MouseLeftButtonDown="Title_MouseDown">
                <Grid>
                    <TextBlock x:Name="LabTitle" Text="正在下载" Foreground="White" FontSize="14"
                               Margin="16,0,0,0" VerticalAlignment="Center" />
                    <Button Style="{DynamicResource TitleButton}" HorizontalAlignment="Right" Margin="0,0,8,0"
                            Click="BtnClose_Click">
                        <Path Data="{StaticResource IconClose}" Stroke="White" StrokeThickness="1.4" Width="10"
                              Height="10" Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LabStage" Text="准备中…" FontSize="14" FontWeight="SemiBold" />
                <ProgressBar x:Name="Bar" Grid.Row="1" Margin="0,12,0,0" Value="0" />
                <Border Grid.Row="2" Margin="0,14,0,0" Background="{DynamicResource ColorBrushGray8}"
                        CornerRadius="4" Padding="10">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LabLog" Text="" FontSize="11.5" FontFamily="Consolas, Microsoft YaHei UI"
                                   Foreground="{DynamicResource ColorBrushGray2}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,18,16">
                <Button x:Name="BtnCancel" Style="{DynamicResource SecondaryButton}" Content="取消"
                        Click="BtnCancel_Click" Margin="0,0,8,0" />
                <Button x:Name="BtnOk" Style="{DynamicResource PrimaryButton}" Content="后台运行" Visibility="Collapsed"
                        Click="BtnOk_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
